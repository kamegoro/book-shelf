{
  "name": "book_shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docker:compose": "docker-compose up -d",
    "prisma:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "npx prisma migrate reset && pnpm run prisma:migrate && ts-node scripts/seed.ts",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "prettier": "prettier --write src",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.14.15",
    "@mui/material": "5.14.15",
    "@prisma/client": "5.22.0",
    "@sendgrid/mail": "8.1.6",
    "bcrypt": "6.0.0",
    "cookie": "0.7.2",
    "dayjs": "1.11.10",
    "jsonwebtoken": "9.0.2",
    "next": "16.4.6",
    "nprogress": "0.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.47.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@faker-js/faker": "10.6.0",
    "@mermaid-js/mermaid-cli": "11.17.1",
    "@next/eslint-plugin-next": "15.5.29",
    "@prisma/generator-helper": "5.22.0",
    "@types/bcrypt": "6.0.0",
    "@types/cookie": "0.6.0",
    "@types/jsonwebtoken": "9.0.4",
    "@types/node": "18.18.6",
    "@types/nprogress": "0.2.2",
    "@types/react": "18.2.31",
    "@types/react-dom": "18.2.14",
    "@typescript-eslint/eslint-plugin": "6.8.0",
    "@typescript-eslint/parser": "6.8.0",
    "eslint": "8.51.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hook-form": "0.3.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "8.0.3",
    "lint-staged": "16.4.0",
    "prettier": "3.0.3",
    "prisma": "5.22.0",
    "prisma-erd-generator": "2.5.0",
    "ts-node": "10.9.2",
    "typescript": "5.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "pnpm run lint",
    "*": "pnpm run prettier"
  },
  "comment": {
    "scripts": {
      "docker:compose": "Docker on limaの場合は`docker compose up -d`"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "puppeteer"
    ],
    "overrides": {
      "katex": "0.18.10"
    }
  }
}
